# Sjabloon voor de DEV-omgeving. Kopieer naar `.env` en vul in.
# Zie docs/SETUP-WINDOWS.md (laptop) en infra/DEPLOY.md (InterServer).

# In welke omgeving hoort dit bestand? development | test | production
# Verplicht: de app weigert te starten zonder, en de seedscripts en migraties
# controleren hierop of ze de juiste database te pakken hebben.
APP_ENV=development

# Poort waarop `npm run dev` luistert. Op de laptop 3000; in de dev-map op
# InterServer 3300, want daar zijn 3000/3001/3100/3200 al bezet.
PORT=3000

# Postgres-verbinding voor Drizzle (migraties, seed en app).
# LET OP: de database `ticketsysteem` (zonder achtervoegsel) is PRODUCTIE op
# InterServer. Dev gebruikt `ticketsysteem_dev`, test `ticketsysteem_test`.
# Deze URL wijst nooit naar een database op een andere machine.
DATABASE_URL=postgresql://user:wachtwoord@localhost:5432/ticketsysteem_dev

# Map voor geüploade cover-afbeeldingen. Elke omgeving zijn eigen map, anders
# schrijven dev, test en productie door elkaar. Buiten productie mag dit relatief.
UPLOAD_DIR=./uploads

# Servergeheim voor de HMAC in de ticketcode ({uuid}.{hmac}) — harde regel 1.
# Genereer iets willekeurigs, bijv.: openssl rand -hex 32
TICKET_SECRET=verander-dit-in-een-lang-willekeurig-geheim

# Better Auth: sessie-/cookiegeheim en publieke basis-URL van de app.
# BETTER_AUTH_SECRET: openssl rand -hex 32
BETTER_AUTH_SECRET=verander-dit-in-een-lang-willekeurig-geheim
BETTER_AUTH_URL=http://localhost:3000

# Basis-URL waarop kopers de ticketpagina openen (/t/{code}). Lokaal is dat
# hetzelfde als BETTER_AUTH_URL, in productie het echte domein. Bewust apart:
# de ticketlink gaat naar buiten en moet publiek bereikbaar zijn.
# Buiten productie mag hier NOOIT tickets.mijnonline.shop staan — dan komen je
# testticketlinks op productie uit. De app weigert dan te starten.
PUBLIC_BASE_URL=http://localhost:3000

# Resend (transactionele mail). Buiten productie MOET dit leeg blijven: met een
# echte key stuurt een test werkelijk mail naar echte adressen, vanaf het
# productiedomein. Leeg = de mail wordt alleen naar de console gelogd. Het afzenderdomein moet in
# Resend via DNS geverifieerd zijn, anders weigert de API het bericht. Voor een
# snelle test kan MAIL_AFZENDER_EMAIL=onboarding@resend.dev (alleen naar je eigen
# account-adres) zonder domeinverificatie.
MAIL_API_KEY=
MAIL_AFZENDER_NAAM=Ticketsysteem
MAIL_AFZENDER_EMAIL=tickets@example.com

# Admin-account dat `npm run db:seed-admin` aanmaakt (Amresh).
ADMIN_EMAIL=amresh@example.com
ADMIN_PASSWORD=verander-mij-nu
ADMIN_NAME=Amresh

# Google-login voor kopers (fase K). Optioneel: zonder deze twee werkt de
# e-mailcode-login gewoon als fallback. Aanmaken in de Google Cloud Console
# (OAuth 2.0 client-ID, type "Web application"). Registreer als geautoriseerde
# redirect-URI: {BETTER_AUTH_URL}/api/auth/callback/google — dus
# http://localhost:3000/api/auth/callback/google voor dev én de prod-variant.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
