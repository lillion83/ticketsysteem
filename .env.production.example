# Sjabloon voor PRODUCTIE op InterServer. Kopieer naar `.env.production` in de
# productiemap (/home/amresh/ticketsysteem) en vul de echte waarden in.
# Dit bestand staat in .gitignore — de echte versie komt nooit in Git.
#
# Waarom deze naam en niet .env.local: `.env.local` is de enige naam die
# nitro/vite automatisch inleest én voorrang geeft boven `.env`. Daardoor draaide
# een `npm run dev` in de productiemap met deze productiewaarden: echte mailkey,
# echte ticketlinks. Nitro leest `.env.${mode}`, dus dit bestand wordt in
# dev-mode nooit aangeraakt.
#
# Volledige procedure: infra/DEPLOY.md

# Verplicht. Hierop weigeren de seedscripts te draaien en hierop controleert
# db:migrate:prod of het de juiste database te pakken heeft.
APP_ENV=production

# Moet overeenkomen met de poort in het Caddy-siteblok (infra/ticketsysteem.caddy).
PORT=3100

# De productiedatabase. Deze naam heeft GEEN achtervoegsel; dev en test hebben
# _dev en _test. Zet eenmalig de omgevingsmarker, zodat de seedscripts hier
# weigeren en db:omgeving:prod het kan bevestigen:
#   COMMENT ON DATABASE ticketsysteem IS 'app_env=production';
DATABASE_URL=postgresql://ticket:wachtwoord@localhost:5432/ticketsysteem

# NOOIT wijzigen na de eerste uitgifte: alle bestaande QR-codes zijn hiermee
# gesigneerd en verifiëren daarna niet meer. Dev en test hebben bewust een ánder
# geheim, zodat een testticket nooit aan de echte deur groen scant.
TICKET_SECRET=

# Better Auth. BETTER_AUTH_URL moet exact het https-adres zijn, anders krijg je
# INVALID_ORIGIN bij het inloggen.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://tickets.mijnonline.shop
PUBLIC_BASE_URL=https://tickets.mijnonline.shop

# Verplicht in productie: de app weigert te starten met een relatief pad, want
# een git clean of een verplaatste checkout zou de klantdata meenemen. Deze map
# ligt bewust buiten de repo en moet apart in de back-up (staat niet in de
# database-dump).
UPLOAD_DIR=/home/amresh/ticketsysteem-data/uploads

# Resend. Het afzenderdomein moet in Resend via DNS geverifieerd zijn.
MAIL_API_KEY=
MAIL_AFZENDER_NAAM=Ticketsysteem
MAIL_AFZENDER_EMAIL=tickets@mijnonline.shop

# Admin-account. De seedscripts weigeren op productie, dus dit account wordt hier
# niet aangemaakt of gewijzigd; deze waarden zijn alleen de referentie.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Amresh

# Google-login voor kopers. Geautoriseerde redirect-URI in de Google Cloud Console:
#   https://tickets.mijnonline.shop/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
