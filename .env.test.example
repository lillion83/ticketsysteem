# Sjabloon voor de TEST-omgeving. Kopieer naar .env.test en vul in. De test-
# database staat los van dev (ticketsysteem_dev) zodat je vrij kunt seeden en
# experimenteren. Gebruik via: db:migrate:test, db:seed:test, db:seed-admin:test
# en dev:test (draait de app op poort 3200).

# In welke omgeving hoort dit bestand? Verplicht; de scripts controleren hierop.
APP_ENV=test

# Aparte test-database. Alleen de databasenaam verschilt van .env; maak hem aan
# met:  createdb ticketsysteem_test   (of via psql: CREATE DATABASE ...)
# Zet daarna eenmalig de omgevingsmarker, anders weigeren de seedscripts:
#   COMMENT ON DATABASE ticketsysteem_test IS 'app_env=test';
DATABASE_URL=postgresql://user:wachtwoord@localhost:5432/ticketsysteem_test

# Eigen uploadmap, zodat een testupload niet tussen de dev- of productiecovers belandt.
UPLOAD_DIR=./uploads-test

# Mogen dezelfde geheimen als .env zijn; de test-DB is lokaal.
TICKET_SECRET=verander-dit-in-een-lang-willekeurig-geheim
BETTER_AUTH_SECRET=verander-dit-in-een-lang-willekeurig-geheim

# Eigen poort zodat de testomgeving naast de dev-server — en op InterServer ook
# naast productie (3100) — kan draaien. dev:test zet PORT bij het opstarten.
PORT=3200
BETTER_AUTH_URL=http://localhost:3200
PUBLIC_BASE_URL=http://localhost:3200

# Leeg laten → mail wordt alleen naar de console gelogd (prima voor tests).
MAIL_API_KEY=
MAIL_AFZENDER_NAAM=Ticketsysteem (test)
MAIL_AFZENDER_EMAIL=onboarding@resend.dev

# Admin-account dat `npm run db:seed-admin:test` aanmaakt.
ADMIN_EMAIL=amresh@example.com
ADMIN_PASSWORD=verander-mij-nu
ADMIN_NAME=Amresh (test)

# Google-login vereist een redirect-URI per poort; voor test meestal leeg laten
# (de e-mailcode-login werkt als fallback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
